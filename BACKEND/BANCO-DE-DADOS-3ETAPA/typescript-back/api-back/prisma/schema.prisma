// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


/ ==========================================
// ENUMS
// ==========================================

enum StatusPedido {
  pendente
  preparo
  pronto
  entregue
}

// ==========================================
// MODELOS
// ==========================================

model Usuario {
  id           Int            @id @default(autoincrement())
  nome         String         @db.VarChar(100)
  email        String         @unique @db.VarChar(150)
  senha        String         @db.VarChar(255)
  papel        String?        @default("user") @db.VarChar(20)
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  refreshTokens RefreshToken[]

  @@map("usuarios")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  token     String   @db.Text
  criadoEm  DateTime @default(now()) @map("criado_em")
  expiraEm  DateTime @map("expira_em")

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Produto {
  id           Int               @id @default(autoincrement())
  nome         String            @db.VarChar(100)
  descricao    String            @db.Text
  preco        Decimal           @db.Decimal(10, 2)
  categoria    String?           @db.VarChar(50)
  disponivel   Boolean?          @default(true)
  imagemUrl    String?           @map("imagem_url") @db.VarChar(255)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")

  cardapios    CardapioProduto[]
  itensPedido  ItemPedido[]

  @@map("produto")
}

model Cardapio {
  id           Int               @id @default(autoincrement())
  nome         String            @db.VarChar(100)
  descricao    String?           @db.Text
  disponivel   Boolean?          @default(true)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")

  produtos     CardapioProduto[]

  @@map("cardapio")
}

// Tabela associativa (N:M) entre Cardapio e Produto
model CardapioProduto {
  cardapioId Int      @map("cardapio_id")
  produtoId  Int      @map("produto_id")

  cardapio   Cardapio @relation(fields: [cardapioId], references: [id], onDelete: Cascade)
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([cardapioId, produtoId])
  @@map("cardapio_produto")
}

model Pedido {
  id           Int          @id @default(autoincrement())
  cliente      String?      @db.VarChar(100)
  status       StatusPedido @default(pendente)
  total        Decimal      @db.Decimal(10, 2)
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  itens        ItemPedido[]

  @@map("pedido")
}

// Tabela associativa entre Pedido e Produto
model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@map("item_pedido")
}