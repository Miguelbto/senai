generator client {
  provider        = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")
}

enum StatusPedido {
  PENDENTE @map("pendente")
  PREPARO  @map("preparo")
  PRONTO   @map("pronto")
  ENTREGUE @map("entregue")
}

model Usuario {
  id           Int            @id @default(autoincrement())
  nome         String         @db.VarChar(100)
  email        String         @unique @db.VarChar(150)
  senha        String         @db.VarChar(255)
  papel        UserRole       @default(USER)
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")
  tokens       RefreshToken[]

  @@map("usuarios")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  token     String   @db.Text
  criadoEm  DateTime @default(now()) @map("criado_em")
  expiraEm  DateTime @map("expira_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Produto {
  id           Int               @id @default(autoincrement())
  nome         String            @db.VarChar(100)
  descricao    String            @db.Text
  preco        Decimal           @db.Decimal(10, 2)
  categoria    String?           @db.VarChar(50)
  disponivel   Boolean           @default(true)
  imagemUrl    String?           @map("imagem_url") @db.VarChar(255)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")
  cardapios    CardapioProduto[]
  itensPedido  ItemPedido[]

  @@map("produto")
}

model Cardapio {
  id           Int               @id @default(autoincrement())
  nome         String            @db.VarChar(100)
  descricao    String?           @db.Text
  disponivel   Boolean           @default(true)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")
  produtos     CardapioProduto[]

  @@map("cardapio")
}

model CardapioProduto {
  cardapioId Int @map("cardapio_id")
  produtoId  Int @map("produto_id")

  cardapio Cardapio @relation(fields: [cardapioId], references: [id], onDelete: Cascade)
  produto  Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([cardapioId, produtoId])
  @@map("cardapio_produto")
}

model Pedido {
  id           Int          @id @default(autoincrement())
  cliente      String?      @db.VarChar(100)
  status       StatusPedido @default(PENDENTE)
  total        Decimal      @db.Decimal(10, 2)
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")
  itens        ItemPedido[]

  @@map("pedido")
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@map("item_pedido")
}

model InvalidToken {
  id       Int      @id @default(autoincrement())
  token    String   @unique @db.VarChar(500)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("invalid_tokens")
}