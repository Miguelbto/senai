NODE_ENV=development
PORT=3000

# Em desenvolvimento local com `npm run start:dev` (fora do Docker),
# use localhost. Dentro do docker-compose, o app.environment já
# sobrescreve isso para apontar para os nomes de serviço (postgres/redis).
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_api
REDIS_HOST=localhost
REDIS_PORT=6379

# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-forte-de-32-ou-mais-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-valor-tambem-por-outro-segredo-forte-diferente
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
