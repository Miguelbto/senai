# ╔══════════════════════════════════════════════════════════════════╗
# ║               VARIÁVEIS DE AMBIENTE — JWT STUDY                ║
# ╠══════════════════════════════════════════════════════════════════╣
# ║  Copie este arquivo para ".env" e preencha os valores reais.   ║
# ║  NUNCA commite o arquivo .env no Git!                          ║
# ╚══════════════════════════════════════════════════════════════════╝

# Porta do servidor Express
PORT=3000

# Segredo usado para ASSINAR e VERIFICAR os tokens JWT.
# Em produção, use um valor longo e aleatório (ex: openssl rand -hex 64)
JWT_SECRET=meu_segredo_super_secreto_trocar_em_producao

# Tempo de vida do token (ex: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h
